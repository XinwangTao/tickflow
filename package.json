{
  "name": "tickflow",
  "version": "0.1.0",
  "description": "刻度清单 TickFlow — 本地优先的任务管理桌面应用",
  "main": "./out/main/index.js",
  "author": "TickFlow",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:ai": "vitest run tests/ai.test.ts tests/ai-cancel.test.ts tests/ai-summary-ui.test.ts tests/ai-settings-ui.test.ts tests/quick-add-regression.test.ts tests/quick-add.test.ts tests/quick-add-draft.test.ts tests/quick-add-ui.test.ts tests/calendar-add.test.ts tests/calendar-add-ui.test.ts tests/recurrence.test.ts tests/subtask-draft.test.ts tests/subtask-draft-ui.test.ts tests/voice.test.ts tests/voice-ui.test.ts tests/asr.test.ts",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:android": "node scripts/android-smoke.mjs",
    "test:android:inpage": "node scripts/android-smoke-inpage.mjs",
    "dist": "npm run build && npm run check:bundle && electron-builder --win",
    "check:bundle": "node scripts/check-bundle.mjs",
    "perf:list": "node scripts/perf-tasklist.mjs",
    "check:mobile-web": "node scripts/mobile-web-check.mjs"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rrule": "^2.8.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "com.tickflow.app",
    "productName": "刻度清单",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/react/**",
      "!node_modules/react-dom/**",
      "!node_modules/scheduler/**",
      "!node_modules/framer-motion/**",
      "!node_modules/motion-dom/**",
      "!node_modules/motion-utils/**",
      "!node_modules/zustand/**"
    ],
    "extraResources": [
      {
        "from": "resources/tray.png",
        "to": "tray.png"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "scripts/voice",
        "to": "scripts/voice"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "刻度清单"
    }
  }
}
